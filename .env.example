# ==========================================================
# DESIGNHUB — MODELO DE VARIÁVEIS (SEM SEGREDOS REAIS)
# Copie para .env.local na raiz e preencha localmente.
# ==========================================================

# APP
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# SUPABASE — FRONTEND: somente valores PUBLICÁVEIS podem usar VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE — BACKEND
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# META / WHATSAPP CLOUD API
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# META / INSTAGRAM
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# URL pública utilizada em webhooks quando houver
PUBLIC_BACKEND_URL=
