# ==========================================================
# DESIGNHUB — MODELO DE VARIÁVEIS (SEM SEGREDOS REAIS)
# Copie para .env.local na raiz e preencha localmente.
# ==========================================================

# APP
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# SUPABASE — FRONTEND: somente valores PUBLICÁVEIS podem usar VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE — BACKEND
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# META / WHATSAPP CLOUD API
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Template pré-aprovado no Business Manager para a 1ª mensagem (RF004/item 20)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Template dedicado e distinto do acima para o aviso "arte publicada" fora da
# janela de 24h (item 9.2/9.4/item 8) — exige aprovação própria da Meta;
# sem ele, o aviso fica BLOCKED_EXTERNAL e a publicação permanece válida.
WHATSAPP_TEMPLATE_NAME_PUBLICACAO=
# Template dedicado para o alerta ao designer quando o cliente cancela um
# agendamento (item 8.6) — exige aprovação própria da Meta; sem ele, o
# alerta por WhatsApp fica BLOCKED_EXTERNAL (o alerta in-app continua ativo).
WHATSAPP_TEMPLATE_NAME_ALERTA_DESIGNER=

# META / INSTAGRAM — ADR 0005: credencial de publicação é POR CLIENTE
# (cliente_instagram_conexao), nunca uma conta global. Estas duas variáveis
# são só do App Meta usado no handshake OAuth ("Conectar Instagram" na tela
# de Clientes) — não publicam nada sozinhas.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Item N.5.5: chave simétrica (mín. 32 caracteres) usada pelo pgcrypto para
# cifrar/decifrar o access_token do Instagram em repouso. Nunca persistida
# no banco — gere um valor aleatório único por ambiente (ex.:
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
INSTAGRAM_TOKEN_ENC_KEY=

# URL pública do backend — usada em webhooks e como redirect_uri do OAuth do Instagram
PUBLIC_BACKEND_URL=

# RF014/seção 11 — segredo do endpoint interno de publicação (chamado pelo
# job/cron de agendamentos vencidos, nunca por um usuário autenticado).
# Mínimo de 32 caracteres aleatórios (ex.: openssl rand -hex 32).
INTERNAL_JOB_SECRET=

# Item 9 — Web Push (VAPID): aviso "publicação em 2h" ao designer.
# Gere o par uma vez com `npx web-push generate-vapid-keys` (gratuito, sem
# serviço pago). O frontend busca a chave pública em runtime via
# GET /api/push/vapid-public-key (rota sem autenticação, não é segredo) —
# não precisa de variável própria no frontend.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:designhub@example.com

# Item 16 — IA classificadora de intenção (autorizada nesta rodada). Camada
# gratuita do Google AI Studio (https://aistudio.google.com/apikey), sem
# billing habilitado. Usada só para classificar sim/não/indefinido na
# resposta de confirmação inicial do WhatsApp quando a regra determinística
# não consegue decidir — sem a chave, o fluxo usa só a regra determinística
# (nunca bloqueia o atendimento).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
