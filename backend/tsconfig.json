{
  "compilerOptions": {
    // Fase 16: opções antes herdadas de ../tsconfig.base.json, inlined
    // aqui para o workspace compilar sozinho (a Vercel builda cada
    // projeto do monorepo isolado no seu rootDirectory, sem acesso a
    // arquivos do repositório pai).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
