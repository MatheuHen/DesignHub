{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "installCommand": "npm install && npm run build:vercel-function",
  "buildCommand": "npm run build:vercel-function",
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
